<script src="https://unpkg.com/alpinejs" defer></script>

<header x-data="{ open: false }" class="w-full bg-white px-6 py-4 md:px-8 border-b border-gray-200">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Logos -->

  <div class="flex items-center space-x-1">
  <!-- Logo -->
  <a href="https://einsteinmed.edu/">
    <img src="{{ '/assets/logos/logo3.png' | url }}" alt="Einstein Logo" class="h-12 w-auto object-contain shrink-0 min-w-[100px]" />
  </a>

  <!-- Lab Name and Department -->
  <a href="{{ '/' | url }}" class="flex flex-col leading-tight text-inherit no-underline">
    <span class="text-xl font-bold text-black">Steidl Lab</span>
    {# <span class="text-sm italic text-gray-600 whitespace-nowrap">Department of Cell Biology</span> #}
  </a>
</div>

    <!-- Burger icon -->
    <button @click="open = !open" class="md:hidden text-2xl" aria-label="Toggle menu">
      ☰
    </button>

    <!-- Desktop nav -->
    <nav class="hidden md:block">
      <ul class="flex gap-6 font-semibold text-sm whitespace-nowrap overflow-x-auto">
        <li><a href="{{ '/' | url }} " class="{{ 'text-einstein-blue' if url === 'home' }} hover:underline underline-offset-4">Home</a></li>
        <li><a href="{{ '/people' | url }} " class="{{ 'text-einstein-blue' if url === 'people' }} hover:underline underline-offset-4">People</a></li>
        <li><a href="{{ '/research' | url }} " class="{{ 'text-einstein-blue' if url === 'research' }} hover:underline underline-offset-4">Research</a></li>
        <li><a href="{{ '/publications' | url }} " class="{{ 'text-einstein-blue' if url === 'publications' }} hover:underline underline-offset-4">Publications</a></li>
        <li><a href="{{ '/fun' | url }} " class="{{ 'text-einstein-blue' if url === 'fun' }} hover:underline underline-offset-4">Fun in the Lab</a></li>
        <li><a href="{{ '/news' | url }} " class="{{ 'text-einstein-blue' if url === 'news' }} hover:underline underline-offset-4">News</a></li>
        <li><a href="{{ '/join' | url }} " class="{{ 'text-einstein-blue' if url === 'join' }} hover:underline underline-offset-4">Join us</a></li>
      </ul>
    </nav>
  </div>

  <!-- Mobile nav -->
  <div x-show="open" class="md:hidden px-4 pt-4 pb-2">
    <ul class="space-y-3 text-sm font-medium">
        <li><a href="{{ '/' | url }} " class="{{ 'text-einstein-blue' if url === 'home' }} hover:underline underline-offset-4">Home</a></li>
        <li><a href="{{ '/people' | url }} " class="{{ 'text-einstein-blue' if url === 'people' }} hover:underline underline-offset-4">People</a></li>
        <li><a href="{{ '/research' | url }} " class="{{ 'text-einstein-blue' if url === 'research' }} hover:underline underline-offset-4">Research</a></li>
        <li><a href="{{ '/publications' | url }} " class="{{ 'text-einstein-blue' if url === 'publications' }} hover:underline underline-offset-4">Publications</a></li>
        <li><a href="{{ '/fun' | url }} " class="{{ 'text-einstein-blue' if url === 'fun' }} hover:underline underline-offset-4">Fun in the Lab</a></li>
        <li><a href="{{ '/news' | url }} " class="{{ 'text-einstein-blue' if url === 'news' }} hover:underline underline-offset-4">News</a></li>
        <li><a href="{{ '/join' | url }} " class="{{ 'text-einstein-blue' if url === 'join' }} hover:underline underline-offset-4">Join us</a></li>
    </ul>
  </div>
</header>