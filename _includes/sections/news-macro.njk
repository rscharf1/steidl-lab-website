{% macro newsmac(headline, pub_date, image, url) %}
  <a href="{{ url }}" target="_blank" class="block hover:shadow-lg transition-shadow duration-200 rounded-lg overflow-hidden">
    <div class="bg-white shadow-md flex flex-col h-[20rem]">

      <!-- Image section -->
      <div class="flex-shrink-0 h-[11rem] md:h-[13rem] w-full overflow-hidden">
        <img src="{{ image }}" alt="{{ headline }}" class="w-full h-full object-cover" />
      </div>

      <!-- Text section -->
      <div class="px-5 py-3 text-center flex-1 flex flex-col items-center justify-start">
        <p class="text-base font-medium text-gray-800 leading-snug mb-1">
          {{ headline }}
        </p>
        <p class="text-sm text-gray-500">
          Published: {{ pub_date }}
        </p>
      </div>

    </div>
  </a>
{% endmacro %}
