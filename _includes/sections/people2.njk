{% import 'sections/people-macro.njk' as macro %}

<section class="bg-white py-16 px-6 md:px-12">  
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Meet the Team</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 items-stretch">

      {% for member in team %}
        
        {{ macro.current_member(
            member.Name,
            member.Title,
            ('/assets/people/' + member.image_name) | url,
            member.Description
          ) }}

      {% endfor %}

    </div>
  </div>
</section>

{% if alumni.length %}
<section class="bg-gray-50 py-16 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-2xl font-bold text-center text-gray-800 mb-10">Lab Alumni</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 items-stretch">
      {% for alum in alumni %}
        {{ macro.alumnus(
          alum.Name,
          alum.Current_position,
          'Former ' + alum.Previous_position,
          ('/assets/alumni/' + alum.image_name) | url
        ) }}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}