{% import 'sections/publications-macro.njk' as macro %}

<section class="bg-white py-16 px-6 md:px-12">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Publications</h2>

    <div class="space-y-10">
      {% for pub in publications %}
        {{ macro.pub(
          pub.Title,
          pub.Authors,
          pub.Journal,
          pub.Date,
          pub.Pubmed_url,
          ('/assets/pubs/' + pub.File) | url
        ) }}
      {% endfor %}
    </div>
  </div>
</section>


