{% import 'sections/publications-macro.njk' as macro %}

<section class="bg-white py-16 px-6 md:px-12">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-4">Selected Publications</h2>

<p class="text-gray-700 text-base mt-4 text-center mb-4">
  For a full list of publications, please visit
  <a href="https://pubmed.ncbi.nlm.nih.gov/?term=Steidl+U&sort=date" target="_blank" rel="noopener noreferrer"
     class="text-blue-600 hover:text-blue-800 underline">
    PubMed
  </a>.
</p>

    <div class="space-y-10">
      {% for pub in publications %}
        {{ macro.pub(
          pub.Title,
          pub.Authors,
          pub.Journal,
          pub.Date,
          pub.Pubmed_url,
          ('/assets/pubs/' + pub.File) | url
        ) }}
      {% endfor %}
    </div>
  </div>
</section>